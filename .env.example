# Copy this file to .env (or export these as real env vars) before running.

# Which LLM does the translation step — the one step in this pipeline that
# calls out over the network (text-line detection/OCR run locally).
# "anthropic" (default) or "openai" — only that provider's API key below is
# actually required; the other can stay blank.
TRANSLATION_PROVIDER=anthropic

# --- Anthropic (used when TRANSLATION_PROVIDER=anthropic) ---

# An Anthropic API key: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Model used for translation. claude-sonnet-5 is the default: it's
# meaningfully cheaper than Opus-tier and is plenty capable for reading a
# page and translating dialogue coherently. Bump to claude-opus-5 if you
# want the highest translation quality and don't mind paying more.
ANTHROPIC_MODEL=claude-sonnet-5

# How hard the model thinks per request. "medium" is a good cost/quality
# balance for this task; raise to "high" if translations feel shallow.
ANTHROPIC_EFFORT=medium

# --- OpenAI (used when TRANSLATION_PROVIDER=openai) ---

# An OpenAI API key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Model used for translation — must support both vision (image input) and
# function/tool calling. gpt-4.1 is a reasonable default; swap in whatever
# current model fits your budget/quality needs.
OPENAI_MODEL=gpt-4.1

# --- Shared ---

# Where uploads, job state (SQLite), and rendered pages are stored.
DATA_DIR=./data

# Images are downsampled to this many pixels on the long edge before being
# sent to the translation model — image tokens are the dominant cost
# driver, and manga text rarely needs more resolution than this to stay
# legible. OCR itself runs locally at full resolution (see
# app/pipeline/ocr.py) and is unaffected by this — this only controls what
# the translation model sees for context.
MAX_IMAGE_LONG_EDGE=1600
